# Variables de entorno de Leo Hub (LoMaximoLeo).
# Copia este archivo a .env y complétalo. NUNCA subas secretos reales al repo.

# --- Supabase (Lovable Cloud) ---
# Las claves publicables (VITE_*) son públicas por diseño.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Service role: SOLO servidor. Bypassa RLS. Lo inyecta Lovable Cloud en runtime.
# No lo pongas en variables VITE_ ni lo expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Binance Pay Merchant (pago automático) ---
# SOLO servidor (sin prefijo VITE_). Requiere una cuenta de Binance Merchant.
# Si estas variables faltan, el checkout sigue funcionando con el pago manual
# por comprobante; el botón automático mostrará "Binance Pay no está configurado".
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=
# Producción: https://bpay.binanceapi.com  (usa la URL de sandbox para pruebas)
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
